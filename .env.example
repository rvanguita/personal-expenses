# MySQL Database Configuration
MYSQL_HOST="127.0.0.1"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD="your_database_password_here"

# Medallion Table Name (unified across raw, bronze, silver databases)
MYSQL_TABLE="personal_expenses"

# Medallion Architecture Database Names
MYSQL_DB_RAW="raw"
MYSQL_DB_BRONZE="bronze"
MYSQL_DB_SILVER="silver"

# Google Gemini AI API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"

# Analytics Configuration
REFERENCE_BUDGET_LIMIT="10000"

# Optional machine-local learned category dictionary
CATEGORY_LOCAL_PATH="data/categories.local.json"

# Streamlit Configuration
STREAMLIT_PORT="8503"
STREAMLIT_SERVER_PORT="8503"
